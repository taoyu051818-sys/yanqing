[Unit]
Description=Yanqing Badminton Acceptance API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/yanqing-domain/source
EnvironmentFile=/home/ubuntu/yanqing-domain/.env.api
Environment=PATH=/opt/node-v24.19.0/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/node-v24.19.0/bin/node apps/api/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/yanqing-domain/storage

[Install]
WantedBy=multi-user.target
