{
  "name": "yanqing-badminton-ecosystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm dev:api",
    "dev:legacy-web": "next dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "dev:miniapp": "pnpm --dir apps/miniapp dev:mp-weixin",
    "build": "pnpm build:api && pnpm build:miniapp",
    "build:legacy-web": "next build",
    "typecheck:legacy-web": "tsc --noEmit",
    "build:api": "pnpm --dir apps/api build",
    "build:miniapp": "pnpm --dir apps/miniapp build:mp-weixin",
    "build:all": "pnpm build",
    "start:legacy-web": "next start",
    "lint": "pnpm --dir apps/api lint && pnpm --dir packages/shared type-check && pnpm --dir apps/miniapp type-check",
    "test:api": "pnpm --dir apps/api test",
    "test:miniapp": "pnpm --dir apps/miniapp test",
    "test:shared": "pnpm --dir packages/shared test",
    "typecheck:miniapp": "pnpm --dir apps/miniapp type-check",
    "verify": "pnpm test:shared && pnpm test:api && pnpm test:miniapp && pnpm --dir apps/api test:e2e && pnpm build:api && pnpm typecheck:miniapp && pnpm build:miniapp",
    "verify:full": "pnpm verify && pnpm build:legacy-web"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.10.1",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
