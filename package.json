{
  "name": "yanqing-badminton-ecosystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm dev:api",
    "dev:legacy-web": "pnpm --dir legacy/web dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "dev:miniapp": "pnpm --dir apps/miniapp dev:mp-weixin",
    "build": "pnpm build:api && pnpm build:miniapp && pnpm build:admin",
    "build:legacy-web": "pnpm --dir legacy/web build",
    "typecheck:legacy-web": "pnpm --dir legacy/web type-check",
    "build:api": "pnpm --dir apps/api build",
    "build:miniapp": "pnpm --dir apps/miniapp build:mp-weixin",
    "release:miniapp:prepare": "node scripts/release-miniapp.mjs prepare",
    "release:miniapp:upload": "node scripts/release-miniapp.mjs upload",
    "icons:miniapp": "node scripts/generate-miniapp-icons.mjs",
    "build:all": "pnpm build",
    "start:legacy-web": "pnpm --dir legacy/web start",
    "lint": "pnpm --dir apps/api lint && pnpm --dir packages/shared type-check && pnpm --dir apps/miniapp type-check",
    "test:api": "pnpm --dir apps/api test",
    "test:miniapp": "pnpm --dir apps/miniapp test",
    "test:shared": "pnpm --dir packages/shared test",
    "typecheck:miniapp": "pnpm --dir apps/miniapp type-check",
    "verify": "pnpm test:ops && pnpm test:release:miniapp && pnpm --dir packages/shared build && pnpm test:shared && pnpm test:api && pnpm test:miniapp && pnpm test:admin && pnpm --dir apps/api test:e2e && pnpm build:api && pnpm typecheck:miniapp && pnpm build:miniapp && pnpm build:admin",
    "test:release:miniapp": "node --test scripts/release-miniapp.test.mjs apps/miniapp/scripts/check-wechat-package.test.mjs",
    "verify:full": "pnpm verify && pnpm build:legacy-web",
    "dev:admin": "pnpm --dir apps/admin dev",
    "build:admin": "pnpm --dir apps/admin build",
    "test:admin": "pnpm --dir apps/admin test",
    "test:core-lifecycle": "pnpm --dir apps/api test:core-lifecycle",
    "test:ops": "node --test apps/api/scripts/ops/ops.test.mjs apps/api/scripts/ops/packaging.test.mjs && bash -n deploy/ops/release.sh && bash -n deploy/ops/run.sh",
    "test:ui": "node scripts/test-core-ui.mjs",
    "check:docs": "node scripts/check-doc-links.mjs"
  },
  "devDependencies": {
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.1",
    "playwright": "1.62.1",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "0.35.3"
  }
}
