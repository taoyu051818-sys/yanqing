  updatedAt          DateTime              @updatedAt

  @@unique([classId, startsAt])
  @@index([startsAt, status])
}

model TrainingAttendance {
  id                          String                       @id @default(cuid())
  sessionId                   String
  enrollmentId                String
  status                      AttendanceStatus             @default(PENDING)
  consumedSessions            Int                          @default(0)
  confirmedRevenueCents       Int                          @default(0)
  coachCostAllocatedCents     Int                          @default(0)
  assistantCostAllocatedCents Int                          @default(0)
  materialCostAllocatedCents  Int                          @default(0)
  growthPointsAwarded         Int                          @default(0)
  feedback                    String?
  operatorId                  String?
  checkedInAt                 DateTime?
  consumedAt                  DateTime?
  session                     TrainingSession              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  enrollment                  TrainingEnrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  operator                    User?                        @relation("AttendanceOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  revenueRecognitions         TrainingRevenueRecognition[]
  consumeCorrections          TrainingConsumeCorrection[]
