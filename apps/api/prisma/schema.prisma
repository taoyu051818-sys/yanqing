  unitPriceCents        Int
  amountCents           Int
  metadata              Json?
  order                 Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryTransactions InventoryTransaction[]
  consignmentPayables   ConsignmentPayableEntry[]

  @@index([orderId])
}

model Payment {
  id              String         @id @default(cuid())
  paymentNo       String         @unique
  orderId         String
  userId          String
  operatorId      String
  channel         PaymentChannel
  amountCents     Int
  status          PaymentStatus  @default(CREATED)
  providerTradeNo String?        @unique
  idempotencyKey  String         @unique
  providerPayload Json?
  paidAt          DateTime?
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user            User           @relation("PaymentPayer", fields: [userId], references: [id], onDelete: Restrict)
  operator        User           @relation("PaymentOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orderId, status])
  @@index([operatorId, channel, paidAt])
}

model Refund {
  id                  String                    @id @default(cuid())
  refundNo            String                    @unique
  // Client supplied key used to make repeated refund taps safe.  Nullable
  // keeps the migration backwards-compatible with refunds created before
  // idempotency was introduced; new requests always persist a derived key.
  idempotencyKey      String?                   @unique
  orderId             String
  requestedById       String
  approvedById        String?
  amountCents         Int
  reason              String
  originalOrderStatus OrderStatus
  status              RefundStatus              @default(REQUESTED)
  providerRefundNo    String?                   @unique
  requestedAt         DateTime                  @default(now())
  approvedAt          DateTime?
  completedAt         DateTime?
  order               Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy         User                      @relation("RequestedRefunds", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy          User?                     @relation("ApprovedRefunds", fields: [approvedById], references: [id], onDelete: SetNull)
  consignmentPayables ConsignmentPayableEntry[]

  @@index([orderId, status])
  @@index([status, requestedAt])
}

model Game {
