model TrainingEnrollment {
  id                    String                       @id @default(cuid())
  enrollmentNo          String                       @unique
  productId             String
  classId               String?
  studentId             String?
  buyerId               String
  orderId               String?                      @unique
  contractNo            String                       @unique
  totalSessions         Int
  consumedSessions      Int                          @default(0)
  totalAmountCents      Int
  prepaidBalanceCents   Int
  confirmedRevenueCents Int                          @default(0)
  refundedCents         Int                          @default(0)
  status                TrainingEnrollmentStatus     @default(PENDING_PAYMENT)
  seatReservedUntil     DateTime?
  startsAt              DateTime
  expiresAt             DateTime
  guardianAuthorization Json?
