model TrainingRevenueRecognition {
  id                        String                      @id @default(cuid())
  attendanceId              String
  enrollmentId              String
  settlementId              String?
  type                      TrainingRecognitionType     @default(CONSUME)
  sequence                  Int                         @default(1)
  reversalOfId              String?                     @unique
  effectiveRevenueCents     Int
  contractRateBps           Int                         @default(2000)
  venueContributionCents    Int
  venueFeeCents             Int                         @default(0)
  trainingPayableVenueCents Int                         @default(0)
  idempotencyKey            String                      @unique
  attendance                TrainingAttendance          @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  enrollment                TrainingEnrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  settlement                TrainingSettlement?         @relation(fields: [settlementId], references: [id], onDelete: SetNull)
