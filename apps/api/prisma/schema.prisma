generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  MEMBER
  FRONT_DESK
  COACH
  EVENT_MANAGER
  HOST
  MERCHANT
  FINANCE
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETED
}

enum MemberLevel {
  EXPERIENCE
  REGULAR
  GOLD
  BLACK
}

enum AccountType {
  CASH_PRINCIPAL
  GIFT_BALANCE
  BADMINTON_COIN
  EVENT_POINTS
  GROWTH_POINTS
}

enum AccountTxnKind {
  CREDIT
  DEBIT
  FREEZE
  UNFREEZE
  EXPIRE
  REVERSAL
}

enum AccountAdjustmentStatus {
  REQUESTED
  POSTED
  REJECTED
}

enum BusinessType {
  VENUE
  GAME
  EVENT
  TRAINING
  GOODS
  MEMBERSHIP
  RECHARGE
  ALLIANCE
}

enum SubjectAccount {
  VENUE
  TRAINING
}

enum PaymentChannel {
  WECHAT
  CASH_PRINCIPAL
  GIFT_BALANCE
  BADMINTON_COIN
  OFFLINE_CASH
  COUPON
}

enum SourceChannel {
  MINI_PROGRAM
  NEWCOMER_COUPON
  ALLIANCE
  REFERRAL
  QUSPORT
  STORE_VISIT
  DOUYIN
  MEITUAN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTING
  TRIAL_RESERVED
  ATTENDED
  CONVERTED
  LOST
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  CHECKED_IN
  COMPLETED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CLOSED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum CourtZone {
  EAST
  WEST
  SOUTH
  NORTH
}

enum CourtUsage {
  RETAIL
  TRAINING
  MEMBER_BLOCK
  MAINTENANCE
}

enum SlotPeriod {
  EARLY
  DAYTIME
  PRIME
}

enum BookingStatus {
  HELD
  CONFIRMED
  CHECKED_IN
  NO_SHOW
  COMPLETED
  CANCELLED
}

enum CourtClosureStatus {
  ACTIVE
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  FROZEN
}

enum GameLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  MIXED
}

enum GameStatus {
  DRAFT
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  WAITLISTED
  REGISTERED
  PAID
  CHECKED_IN
  NO_SHOW
  COMPLETED
  CANCELLED
  REFUNDED
}

enum HostStatus {
  APPLIED
  APPROVED
  REJECTED
  SUSPENDED
}

enum RewardStatus {
  PENDING_OBSERVATION
  AVAILABLE
  GRANTED
  REVERSED
  REJECTED
}

enum EventStatus {
  DRAFT
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventPrizeStatus {
  ISSUED
  RECEIVED
}

enum TeamCategory {
  MEN_DOUBLES
  WOMEN_DOUBLES
  MIXED_DOUBLES
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  CONFIRMED
  CORRECTED
}

enum TrainingAudience {
  YOUTH
  ADULT
}

enum TrainingEnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum TrainingSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  ATTENDED
  LEAVE
  MAKEUP_REQUIRED
  MADE_UP
  ABSENT
  CANCELLED
}

enum TrainingRecognitionType {
  CONSUME
  REVERSAL
}

enum TrainingConsumeCorrectionStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum TrainingTrialStatus {
  RESERVED
  CHECKED_IN
  NO_SHOW
  ASSESSED
  CONVERTED
  LOST
  CANCELLED
}

enum YouthTrainingRuleStatus {
  DRAFT
  PUBLISHED
  REJECTED
  SUPERSEDED
}

enum SettlementStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  SETTLED
  VOID
}

/// A business-day reconciliation moves from an editable opening snapshot to
/// review when unresolved money/settlement items are found, and finally to a
/// locked, immutable close.  Keeping this separate from settlement status
/// lets finance close a day without changing the lifecycle of each statement.
enum ReconciliationPeriodStatus {
  OPEN
  REVIEW
  LOCKED
}

enum FrontDeskShiftStatus {
  OPEN
  CLOSED
}

enum MerchantLevel {
  TRAFFIC_PARTNER
  MEMBER_BENEFIT
  SPONSOR
}

enum CouponStatus {
  ISSUED
  CLAIMED
  REDEEMED
  EXPIRED
  VOID
}

enum InventoryMode {
  PURCHASE
  CONSIGNMENT
}

enum InventoryTxnType {
  PURCHASE_IN
  CONSIGNMENT_IN
  SALE_OUT
  TRAINING_USAGE
  EVENT_USAGE
  TRANSFER_OUT
  TRANSFER_IN
  LOSS_OUT
  STOCKTAKE_GAIN
  STOCKTAKE_LOSS
  ADJUSTMENT
  RETURN_OUT
  STOCKTAKE
}

enum SupplierType {
  OWNED
  CONSIGNMENT
}

enum ConsignmentPayableEntryType {
  SALE
  REFUND_REVERSAL
}

enum ConsignmentSettlementAction {
  CREATED
  SUBMITTED
  CONFIRMED
  DISPUTED
  RETURNED
  SETTLED
  VOIDED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum StocktakeStatus {
  DRAFT
  COUNTING
  REVIEW
  POSTED
}

enum InventoryOperationType {
  TRANSFER
  LOSS
}

enum InventoryOperationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  CANCELLED
}

enum ParameterType {
  STRING
  INTEGER
  DECIMAL
  BOOLEAN
  JSON
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED
}

enum DataErasureRequestStatus {
  REQUESTED
  CANCELLED
  REJECTED
  COMPLETED
}

model User {
  id                                  String                            @id @default(cuid())
  openId                              String?                           @unique
  unionId                             String?                           @unique
  phone                               String?                           @unique
  displayName                         String
  avatarUrl                           String?
  status                              UserStatus                        @default(ACTIVE)
  primaryRole                         AppRole                           @default(MEMBER)
  referrerId                          String?
  referrer                            User?                             @relation("DirectReferral", fields: [referrerId], references: [id], onDelete: SetNull)
  directReferrals                     User[]                            @relation("DirectReferral")
  leadsReferred                       CustomerLead[]                    @relation("LeadReferrer")
  leadsOwned                          CustomerLead[]                    @relation("LeadOwner")
  leadsConverted                      CustomerLead[]                    @relation("LeadConvertedMember")
  leadsCreated                        CustomerLead[]                    @relation("LeadCreator")
  leadFollowUps                       LeadFollowUp[]                    @relation("LeadFollowUpActor")
  roles                               UserRole[]
  memberProfile                       MemberProfile?
  guardianStudents                    Student[]                         @relation("StudentGuardian")
  accounts                            Account[]
  accountAdjustments                  AccountTransaction[]              @relation("AccountOperator")
  requestedAccountAdjustmentReviews   AccountAdjustmentRequest[]        @relation("AccountAdjustmentRequester")
  reviewedAccountAdjustmentReviews    AccountAdjustmentRequest[]        @relation("AccountAdjustmentReviewer")
  memberOrders                        Order[]                           @relation("MemberOrders")
  createdOrders                       Order[]                           @relation("CreatedOrders")
  payments                            Payment[]                         @relation("PaymentPayer")
  operatedPayments                    Payment[]                         @relation("PaymentOperator")
  requestedRefunds                    Refund[]                          @relation("RequestedRefunds")
  approvedRefunds                     Refund[]                          @relation("ApprovedRefunds")
  createdRechargePlans                RechargePlan[]                    @relation("RechargePlanCreator")
  rechargePlanTransitions             RechargePlanTransition[]          @relation("RechargePlanTransitionActor")
  createdMembershipProducts           MembershipProduct[]               @relation("MembershipProductCreator")
  membershipProductTransitions        MembershipProductTransition[]     @relation("MembershipProductTransitionActor")
  createdPriceRules                   PriceRule[]                        @relation("PriceRuleCreator")
  priceRuleTransitions                PriceRuleTransition[]              @relation("PriceRuleTransitionActor")
  courtBookings                       CourtBooking[]                    @relation("MemberBookings")
  fulfilledCourtBookings              CourtBooking[]                    @relation("CourtBookingFulfiller")
  courtClosuresCreated                CourtClosure[]                    @relation("CourtClosureCreator")
  courtClosuresCancelled              CourtClosure[]                    @relation("CourtClosureCanceller")
  hostedGames                         Game[]                            @relation("HostedGames")
  cancelledGames                      Game[]                            @relation("GameCanceller")
  hostProfile                         HostProfile?
  hostRewards                         HostReward[]                      @relation("HostRewards")
  gameRegistrations                   GameRegistration[]
  eventCaptains                       EventTeam[]                       @relation("EventCaptains")
  cancelledEventTeams                 EventTeam[]                       @relation("EventTeamCanceller")
  cancelledEvents                     Event[]                           @relation("EventCanceller")
  trainingPurchases                   TrainingEnrollment[]              @relation("TrainingPurchases")
  trainingTrials                      TrainingTrial[]                   @relation("TrainingTrialMember")
  guardedTrainingTrials               TrainingTrial[]                   @relation("TrainingTrialGuardian")
  coachedTrainingTrials               TrainingTrial[]                   @relation("TrainingTrialCoach")
  createdTrainingTrials               TrainingTrial[]                   @relation("TrainingTrialCreator")
  trainingTrialTransitions            TrainingTrialTransition[]         @relation("TrainingTrialTransitionActor")
  requestedYouthTrainingRules         YouthTrainingRule[]               @relation("YouthTrainingRuleRequester")
  reviewedYouthTrainingRules          YouthTrainingRule[]               @relation("YouthTrainingRuleReviewer")
  attendanceOperations                TrainingAttendance[]              @relation("AttendanceOperator")
  requestedTrainingConsumeCorrections TrainingConsumeCorrection[]       @relation("TrainingConsumeCorrectionRequester")
  reviewedTrainingConsumeCorrections  TrainingConsumeCorrection[]       @relation("TrainingConsumeCorrectionReviewer")
  couponHoldings                      CouponCode[]                      @relation("CouponHolder")
  couponRedemptions                   CouponCode[]                      @relation("CouponRedeemer")
  parameterChanges                    SystemParameter[]                 @relation("ParameterCreator")
  auditLogs                           AuditLog[]                        @relation("AuditActor")
  riskEvents                          RiskEvent[]                       @relation("RiskUser")
  inventoryOperations                 InventoryTransaction[]            @relation("InventoryOperator")
  createdPurchaseOrders               PurchaseOrder[]                   @relation("PurchaseOrderCreator")
  submittedPurchaseOrders             PurchaseOrder[]                   @relation("PurchaseOrderSubmitter")
  approvedPurchaseOrders              PurchaseOrder[]                   @relation("PurchaseOrderApprover")
  purchaseReceipts                    PurchaseReceipt[]                 @relation("PurchaseReceiptOperator")
  createdStocktakes                   Stocktake[]                       @relation("StocktakeCreator")
  submittedStocktakes                 Stocktake[]                       @relation("StocktakeSubmitter")
  reviewedStocktakes                  Stocktake[]                       @relation("StocktakeReviewer")
  postedStocktakes                    Stocktake[]                       @relation("StocktakePoster")
  createdInventoryDocuments           InventoryOperation[]              @relation("InventoryOperationCreator")
  approvedInventoryDocuments          InventoryOperation[]              @relation("InventoryOperationApprover")
  postedInventoryDocuments            InventoryOperation[]              @relation("InventoryOperationPoster")
  createdConsignmentSettlements       ConsignmentSettlement[]           @relation("ConsignmentSettlementCreator")
  submittedConsignmentSettlements     ConsignmentSettlement[]           @relation("ConsignmentSettlementSubmitter")
  confirmedConsignmentSettlements     ConsignmentSettlement[]           @relation("ConsignmentSettlementConfirmer")
  settledConsignmentSettlements       ConsignmentSettlement[]           @relation("ConsignmentSettlementSettler")
  voidedConsignmentSettlements        ConsignmentSettlement[]           @relation("ConsignmentSettlementVoider")
  consignmentSettlementTransitions    ConsignmentSettlementTransition[] @relation("ConsignmentSettlementTransitionActor")
  issuedEventPrizes                   EventPrizeAward[]                 @relation("EventPrizeIssuer")
  signedEventPrizes                   EventPrizeAward[]                 @relation("EventPrizeSigner")
  referralRewardsGiven                ReferralReward[]                  @relation("RewardReferrer")
  referralRewardsEarned               ReferralReward[]                  @relation("RewardNewUser")
  exportJobs                          ExportJob[]
  dataErasureRequests                 DataErasureRequest[]              @relation("DataErasureRequester")
  reviewedDataErasureRequests         DataErasureRequest[]              @relation("DataErasureReviewer")
  notifications                       Notification[]
  closedReconciliationPeriods         ReconciliationPeriod[]            @relation("ClosedReconciliationPeriods")
  operatedFrontDeskShifts             FrontDeskShift[]                  @relation("FrontDeskShiftOperator")
  openedFrontDeskShifts               FrontDeskShift[]                  @relation("FrontDeskShiftOpenedBy")
  closedFrontDeskShifts               FrontDeskShift[]                  @relation("FrontDeskShiftClosedBy")
  reviewedFrontDeskShiftVariances     FrontDeskShift[]                  @relation("FrontDeskShiftVarianceReviewer")
  createdAt                           DateTime                          @default(now())
  updatedAt                           DateTime                          @updatedAt
  deletedAt                           DateTime?

  @@index([referrerId])
  @@index([primaryRole, status])
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  role       AppRole
  merchantId String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, role, merchantId])
  @@index([role])
}

model MemberProfile {
  id                  String               @id @default(cuid())
  userId              String               @unique
  level               MemberLevel          @default(EXPERIENCE)
  tags                String[]
  sourceChannel       SourceChannel        @default(MINI_PROGRAM)
  membershipExpiresAt DateTime?
  isNewCustomer       Boolean              @default(true)
  firstVisitAt        DateTime?
  lastVisitAt         DateTime?
  visitCount          Int                  @default(0)
  consentVersion      String?
  consentedAt         DateTime?
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions       MemberSubscription[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([level, membershipExpiresAt])
  @@index([sourceChannel, createdAt])
}

model CustomerLead {
  id                String          @id @default(cuid())
  displayName       String
  phone             String?
  status            LeadStatus      @default(NEW)
  sourceChannel     SourceChannel
  campaign          String?
  referrerId        String?
  ownerId           String?
  convertedMemberId String?
  createdById       String
  nextFollowUpAt    DateTime?
  slaDueAt          DateTime
  convertedAt       DateTime?
  lostAt            DateTime?
  archivedAt        DateTime?
  lostReason        String?
  referrer          User?           @relation("LeadReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  owner             User?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedMember   User?           @relation("LeadConvertedMember", fields: [convertedMemberId], references: [id], onDelete: SetNull)
  createdBy         User            @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  followUps         LeadFollowUp[]
  trainingTrials    TrainingTrial[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status, slaDueAt])
  @@index([ownerId, status, nextFollowUpAt])
  @@index([sourceChannel, campaign, createdAt])
  @@index([convertedMemberId])
  @@index([phone])
}

model LeadFollowUp {
  id             String       @id @default(cuid())
  leadId         String
  actorId        String
  kind           String
  content        String
  statusBefore   LeadStatus
  statusAfter    LeadStatus
  nextFollowUpAt DateTime?
  lead           CustomerLead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  actor          User         @relation("LeadFollowUpActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@index([leadId, createdAt])
  @@index([actorId, createdAt])
}

model Student {
  id                    String               @id @default(cuid())
  guardianId            String
  displayName           String
  birthMonth            DateTime?
  guardianConsentStatus Boolean              @default(false)
  authorizationNote     String?
  guardian              User                 @relation("StudentGuardian", fields: [guardianId], references: [id], onDelete: Restrict)
  enrollments           TrainingEnrollment[]
  trainingTrials        TrainingTrial[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([guardianId])
}

model Account {
  id                 String                     @id @default(cuid())
  userId             String
  type               AccountType
  balance            Int                        @default(0)
  frozenBalance      Int                        @default(0)
  version            Int                        @default(0)
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       AccountTransaction[]
  adjustmentRequests AccountAdjustmentRequest[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([userId, type])
  @@index([type])
}

model AccountTransaction {
  id                String                    @id @default(cuid())
  accountId         String
  kind              AccountTxnKind
  amount            Int
  balanceBefore     Int
  balanceAfter      Int
  reasonCode        String
  reason            String
  orderId           String?
  operatorId        String?
  idempotencyKey    String                    @unique
  expiresAt         DateTime?
  metadata          Json?
  account           Account                   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order             Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  operator          User?                     @relation("AccountOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  adjustmentRequest AccountAdjustmentRequest?
  createdAt         DateTime                  @default(now())

  @@index([accountId, createdAt])
  @@index([orderId])
}

model AccountAdjustmentRequest {
  id                    String                  @id @default(cuid())
  accountId             String
  amount                Int
  reason                String
  status                AccountAdjustmentStatus @default(REQUESTED)
  requestedById         String
  reviewedById          String?
  requestIdempotencyKey String                  @unique
  commandHash           String
  reviewReason          String?
  transactionId         String?                 @unique
  reviewedAt            DateTime?
  account               Account                 @relation(fields: [accountId], references: [id], onDelete: Restrict)
  requestedBy           User                    @relation("AccountAdjustmentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy            User?                   @relation("AccountAdjustmentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  transaction           AccountTransaction?     @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@index([requestedById, createdAt])
}

model SystemParameter {
  id            String        @id @default(cuid())
  key           String
  value         Json
  type          ParameterType
  description   String
  locked        Boolean       @default(false)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdById   String?
  createdBy     User?         @relation("ParameterCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@unique([key, effectiveFrom])
  @@index([key, effectiveFrom, effectiveTo])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actorRole  AppRole?
  action     String
  objectType String
  objectId   String?
  oldValue   Json?
  newValue   Json?
  reason     String?
  result     AuditResult @default(SUCCESS)
  requestId  String?
  ip         String?
  deviceInfo String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([objectType, objectId, createdAt])
  @@index([requestId])
}

model ReconciliationPeriod {
  id             String                     @id @default(cuid())
  /// The start of the business day in Asia/Shanghai (stored as a UTC instant).
  businessDate   DateTime                   @unique
  status         ReconciliationPeriodStatus @default(OPEN)
  totals         Json
  exceptionCount Int                        @default(0)
  closedById     String?
  closedAt       DateTime?
  detail         Json
  closedBy       User?                      @relation("ClosedReconciliationPeriods", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status, businessDate])
}

model FrontDeskShift {
  id                   String               @id @default(cuid())
  /// Start of the operating day in Asia/Shanghai, stored as a UTC instant.
  businessDate         DateTime
  venueCode            String               @default("MAIN")
  operatorId           String
  status               FrontDeskShiftStatus @default(OPEN)
  openedAt             DateTime             @default(now())
  openingCashCents     Int
  closedAt             DateTime?
  closingCashCents     Int?
  expectedCashCents    Int?
  cashVarianceCents    Int?
  handoverNote         String?
  closeReason          String?
  varianceReviewedById String?
  varianceReviewedAt   DateTime?
  varianceReviewReason String?
  pendingSnapshot      Json?
  openedById           String
  closedById           String?
  operator             User                 @relation("FrontDeskShiftOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  openedBy             User                 @relation("FrontDeskShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy             User?                @relation("FrontDeskShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  varianceReviewedBy   User?                @relation("FrontDeskShiftVarianceReviewer", fields: [varianceReviewedById], references: [id], onDelete: Restrict)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([businessDate, operatorId, venueCode], map: "front_desk_shift_business_operator_venue_key")
  @@index([status, businessDate])
  @@index([venueCode, businessDate])
  @@index([operatorId, openedAt])
  @@index([varianceReviewedById, varianceReviewedAt])
}

model RiskEvent {
  id         String       @id @default(cuid())
  ruleCode   String
  severity   RiskSeverity
  status     RiskStatus   @default(OPEN)
  userId     String?
  orderId    String?
  objectType String
  objectId   String?
  summary    String
  evidence   Json?
  resolvedBy String?
  resolvedAt DateTime?
  user       User?        @relation("RiskUser", fields: [userId], references: [id], onDelete: SetNull)
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([status, severity, createdAt])
  @@index([userId, createdAt])
}

model Court {
  id        String         @id @default(cuid())
  code      String         @unique
  name      String
  zone      CourtZone
  usage     CourtUsage     @default(RETAIL)
  enabled   Boolean        @default(true)
  sortOrder Int
  bookings  CourtBooking[]
  closures  CourtClosure[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([enabled, sortOrder])
}

model CourtClosure {
  id                     String             @id @default(cuid())
  courtId                String
  startsAt               DateTime
  endsAt                 DateTime
  reason                 String
  status                 CourtClosureStatus @default(ACTIVE)
  creationIdempotencyKey String             @unique
  createdById            String
  cancelledById          String?
  cancelledAt            DateTime?
  cancelReason           String?
  court                  Court              @relation(fields: [courtId], references: [id], onDelete: Restrict)
  createdBy              User               @relation("CourtClosureCreator", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy            User?              @relation("CourtClosureCanceller", fields: [cancelledById], references: [id], onDelete: Restrict)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([courtId, status, startsAt])
  @@index([status, startsAt, endsAt])
  @@index([createdById, createdAt])
}

model TimeSlot {
  id           String      @id @default(cuid())
  code         String      @unique
  label        String
  startMinutes Int
  endMinutes   Int
  period       SlotPeriod
  enabled      Boolean     @default(true)
  sortOrder    Int
  priceRules   PriceRule[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model PriceRule {
  id                     String                @id @default(cuid())
  code                   String
  version                Int
  name                   String
  timeSlotId             String?
  weekdayMask            Int                   @default(127)
  priceCents             Int
  newcomerPriceCents     Int?
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  enabled                Boolean               @default(false)
  creationIdempotencyKey String                @unique
  creationCommandHash    String
  createdById            String
  timeSlot               TimeSlot?             @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  createdBy              User                  @relation("PriceRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  transitions            PriceRuleTransition[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([code, version])
  @@index([timeSlotId, enabled, effectiveFrom, effectiveTo])
  @@index([createdById, createdAt])
}

model PriceRuleTransition {
  id             String    @id @default(cuid())
  priceRuleId    String
  oldEnabled     Boolean
  newEnabled     Boolean
  reason         String
  actorId        String
  idempotencyKey String    @unique
  commandHash    String
  priceRule      PriceRule @relation(fields: [priceRuleId], references: [id], onDelete: Restrict)
  actor          User      @relation("PriceRuleTransitionActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now())

  @@index([priceRuleId, createdAt])
  @@index([actorId, createdAt])
}

model CourtBooking {
  id                        String         @id @default(cuid())
  courtId                   String
  memberId                  String?
  orderId                   String?        @unique
  status                    BookingStatus  @default(HELD)
  startsAt                  DateTime
  endsAt                    DateTime
  holdExpiresAt             DateTime?
  usage                     CourtUsage     @default(RETAIL)
  trainingClassId           String?
  gameId                    String?
  note                      String?
  fulfillmentIdempotencyKey String?        @unique
  fulfillmentCommandHash    String?
  fulfillmentReason         String?
  fulfillmentEvidence       Json?
  fulfilledById             String?
  fulfilledAt               DateTime?
  court                     Court          @relation(fields: [courtId], references: [id], onDelete: Restrict)
  member                    User?          @relation("MemberBookings", fields: [memberId], references: [id], onDelete: SetNull)
  order                     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  trainingClass             TrainingClass? @relation(fields: [trainingClassId], references: [id], onDelete: SetNull)
  game                      Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  fulfilledBy               User?          @relation("CourtBookingFulfiller", fields: [fulfilledById], references: [id], onDelete: Restrict)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  // Active bookings are protected by a partial database index (see the
  // follow-up migration).  A plain Prisma @@unique would also include
  // cancelled historical rows and would prevent a customer from booking the
  // same slot again after a cancellation.
  @@index([courtId, startsAt, status])
  @@index([memberId, startsAt])
  @@index([status, endsAt])
  @@index([fulfilledById, fulfilledAt])
}

