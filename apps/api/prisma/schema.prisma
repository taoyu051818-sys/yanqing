  @@unique([attendanceId, sequence], map: "training_recognition_attendance_sequence_key")
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([settlementId])
  @@index([enrollmentId])
}

model TrainingConsumeCorrection {
  id                     String                          @id @default(cuid())
  recognitionId          String
  attendanceId           String
  status                 TrainingConsumeCorrectionStatus @default(REQUESTED)
  reason                 String
  reviewReason           String?
  requestedById          String
  reviewedById           String?
  reversalRecognitionId  String?                         @unique
  requestIdempotencyKey  String                          @unique
  decisionIdempotencyKey String?                         @unique
  requestedAt            DateTime                        @default(now())
  reviewedAt             DateTime?
  recognition            TrainingRevenueRecognition      @relation("TrainingConsumeCorrectionTarget", fields: [recognitionId], references: [id], onDelete: Restrict)
  reversalRecognition    TrainingRevenueRecognition?     @relation("TrainingConsumeCorrectionReversal", fields: [reversalRecognitionId], references: [id], onDelete: Restrict)
  attendance             TrainingAttendance              @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  requestedBy            User                            @relation("TrainingConsumeCorrectionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy             User?                           @relation("TrainingConsumeCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  @@index([status, requestedAt])
  @@index([recognitionId, status])
  @@index([attendanceId, status])
}

model TrainingTrial {
  id                     String                    @id @default(cuid())
  trialNo                String                    @unique
  status                 TrainingTrialStatus       @default(RESERVED)
  leadId                 String?
  studentId              String?
  guardianId             String?
  memberId               String?
  productId              String
  classId                String?
  sessionId              String?
  coachId                String
  sourceChannel          SourceChannel
  scheduledStartsAt      DateTime
  scheduledEndsAt        DateTime
  assessmentDimensions   Json?
  recommendation         String?
  assessmentNote         String?
  convertedEnrollmentId  String?                   @unique
  createdById            String
  creationIdempotencyKey String                    @unique
  creationCommandHash    String
  checkedInAt            DateTime?
  noShowAt               DateTime?
  assessedAt             DateTime?
  convertedAt            DateTime?
  lostAt                 DateTime?
  cancelledAt            DateTime?
  lead                   CustomerLead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  student                Student?                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  guardian               User?                     @relation("TrainingTrialGuardian", fields: [guardianId], references: [id], onDelete: Restrict)
  member                 User?                     @relation("TrainingTrialMember", fields: [memberId], references: [id], onDelete: Restrict)
  product                TrainingProduct           @relation(fields: [productId], references: [id], onDelete: Restrict)
  class                  TrainingClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  session                TrainingSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  coach                  User                      @relation("TrainingTrialCoach", fields: [coachId], references: [id], onDelete: Restrict)
  convertedEnrollment    TrainingEnrollment?       @relation("TrainingTrialConversion", fields: [convertedEnrollmentId], references: [id], onDelete: Restrict)
  createdBy              User                      @relation("TrainingTrialCreator", fields: [createdById], references: [id], onDelete: Restrict)
  transitions            TrainingTrialTransition[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([status, scheduledStartsAt])
  @@index([coachId, status, scheduledStartsAt])
  @@index([guardianId, scheduledStartsAt])
  @@index([memberId, scheduledStartsAt])
  @@index([leadId])
  @@index([studentId])
  @@index([productId, classId])
}

model TrainingTrialTransition {
  id             String               @id @default(cuid())
  trialId        String
  fromStatus     TrainingTrialStatus?
  toStatus       TrainingTrialStatus
  action         String
  reason         String
  payload        Json?
  commandHash    String
  idempotencyKey String               @unique
  actorId        String
  trial          TrainingTrial        @relation(fields: [trialId], references: [id], onDelete: Restrict)
  actor          User                 @relation("TrainingTrialTransitionActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())

  @@index([trialId, createdAt])
  @@index([actorId, createdAt])
  @@index([toStatus, createdAt])
}

model YouthTrainingRule {
  id                     String                  @id @default(cuid())
  version                String                  @unique
  status                 YouthTrainingRuleStatus @default(DRAFT)
  maxTotalSessions       Int
  maxValidityDays        Int
  maxContractAmountCents Int
  warningThresholdDays   Int
  hardBlock              Boolean                 @default(true)
  effectiveFrom          DateTime
  effectiveTo            DateTime?
  requestReason          String
  reviewReason           String?
  requestedById          String
  reviewedById           String?
  requestIdempotencyKey  String                  @unique
  decisionIdempotencyKey String?                 @unique
  commandHash            String
  decisionCommandHash    String?
  reviewedAt             DateTime?
  requestedBy            User                    @relation("YouthTrainingRuleRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy             User?                   @relation("YouthTrainingRuleReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, effectiveFrom, effectiveTo])
  @@index([requestedById, createdAt])
}

model Merchant {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  category            String
  level               MerchantLevel
  contactName         String?
  contactPhone        String?
  status              UserStatus           @default(ACTIVE)
  settlementRule      Json
  cooperationStartsAt DateTime?
  cooperationEndsAt   DateTime?
  userRoles           UserRole[]
  couponTemplates     CouponTemplate[]
  couponRedemptions   CouponCode[]         @relation("CouponRedeemMerchant")
  settlements         AllianceSettlement[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model CouponTemplate {
  id                 String       @id @default(cuid())
  code               String       @unique
  merchantId         String
  name               String
  activityName       String
  benefitDescription String
  faceValueCents     Int          @default(0)
  validFrom          DateTime
  validTo            DateTime
  claimLimitPerUser  Int          @default(1)
  issueLimit         Int
  issuedCount        Int          @default(0)
  claimedCount       Int          @default(0)
  redeemedCount      Int          @default(0)
  enabled            Boolean      @default(true)
  merchant           Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  codes              CouponCode[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([merchantId, enabled, validTo])
}

model CouponCode {
  id                    String         @id @default(cuid())
  templateId            String
  code                  String         @unique
  status                CouponStatus   @default(ISSUED)
  holderId              String?
  redeemedById          String?
  redeemedMerchantId    String?
  attributionOrderId    String?
  claimedAt             DateTime?
  redeemedAt            DateTime?
  expiresAt             DateTime
  attributedAmountCents Int            @default(0)
  idempotencyKey        String?        @unique
  template              CouponTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  holder                User?          @relation("CouponHolder", fields: [holderId], references: [id], onDelete: SetNull)
  redeemedBy            User?          @relation("CouponRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)
  redeemedMerchant      Merchant?      @relation("CouponRedeemMerchant", fields: [redeemedMerchantId], references: [id], onDelete: SetNull)
  attributionOrder      Order?         @relation("CouponAttributionOrder", fields: [attributionOrderId], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([templateId, status])
  @@index([holderId, status])
  @@index([redeemedMerchantId, redeemedAt])
}

model AllianceSettlement {
  id                         String           @id @default(cuid())
  merchantId                 String
  periodStart                DateTime
  periodEnd                  DateTime
  issuedCount                Int
  claimedCount               Int
  redeemedCount              Int
  effectiveNewCustomers      Int
  attributedGmvCents         Int
  attributedGrossProfitCents Int
  cooperationFeeCents        Int
  roi                        Decimal?         @db.Decimal(12, 4)
  status                     SettlementStatus @default(DRAFT)
  detail                     Json
  confirmedAt                DateTime?
  settledAt                  DateTime?
  merchant                   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  @@unique([merchantId, periodStart, periodEnd])
  @@index([status, periodEnd])
}

model ReferralReward {
  id                String       @id @default(cuid())
  referrerId        String
  newUserId         String
  triggerOrderId    String?
  triggerType       String
  rewardType        String
  rewardValue       Int
  status            RewardStatus @default(PENDING_OBSERVATION)
  observationEndsAt DateTime
  grantedAt         DateTime?
  reversedAt        DateTime?
  referrer          User         @relation("RewardReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  newUser           User         @relation("RewardNewUser", fields: [newUserId], references: [id], onDelete: Restrict)
  triggerOrder      Order?       @relation(fields: [triggerOrderId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())

  // A reward is a property of the new member + business trigger, not of a
  // particular order.  Keeping triggerOrderId in the old key allowed two
  // concurrent first payments (with different order ids) to create two
  // rewards.  The trigger order remains an audit/reference field, while this
  // invariant is enforced independently at the database boundary.
  @@unique([newUserId, triggerType])
  @@index([referrerId, status])
}

model InventoryItem {
  id                  String                    @id @default(cuid())
  sku                 String                    @unique
  name                String
  category            String
  mode                InventoryMode
  supplier            String
  purchasePriceCents  Int
  salePriceCents      Int
  stock               Int                       @default(0)
  safeStock           Int                       @default(0)
  supplierId          String?
  defaultLocationId   String?
  batchCode           String?
  expiresAt           DateTime?
  enabled             Boolean                   @default(true)
  transactions        InventoryTransaction[]
  eventPrizeAwards    EventPrizeAward[]
  supplierRecord      Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  defaultLocation     InventoryLocation?        @relation("InventoryItemDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)
  stockBalances       InventoryStockBalance[]
  purchaseOrderLines  PurchaseOrderLine[]
  stocktakeLines      StocktakeLine[]
  inventoryDocuments  InventoryOperation[]
  consignmentPayables ConsignmentPayableEntry[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([enabled, category])
  @@index([stock, safeStock])
  @@index([supplierId, enabled])
  @@index([defaultLocationId, enabled])
  @@index([expiresAt])
}

model InventoryTransaction {
  id                       String               @id @default(cuid())
  itemId                   String
  type                     InventoryTxnType
  quantity                 Int
  stockBefore              Int
  stockAfter               Int
  unitCostCents            Int?
  orderItemId              String?
  operatorId               String
  reason                   String
  idempotencyKey           String               @unique
  metadata                 Json?
  item                     InventoryItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  orderItem                OrderItem?           @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  operator                 User                 @relation("InventoryOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  eventPrizeAward          EventPrizeAward?
  purchaseReceiptLine      PurchaseReceiptLine?
  stocktakeLine            StocktakeLine?
  inventoryOperationSource InventoryOperation?  @relation("InventoryOperationSourceTransaction")
  inventoryOperationTarget InventoryOperation?  @relation("InventoryOperationTargetTransaction")
  createdAt                DateTime             @default(now())

  @@index([itemId, createdAt])
}

model Supplier {
  id                     String                    @id @default(cuid())
  code                   String                    @unique
  name                   String
  type                   SupplierType
  contactName            String?
  contactPhone           String?
  settlementRule         Json?
  enabled                Boolean                   @default(true)
  items                  InventoryItem[]
  purchaseOrders         PurchaseOrder[]
  consignmentPayables    ConsignmentPayableEntry[]
  consignmentSettlements ConsignmentSettlement[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([type, enabled])
}

/// Immutable supplier-payable ledger. SALE is recognised only when a goods
/// order reaches the fulfilment boundary; a successful whole-order refund
/// appends a REFUND_REVERSAL instead of mutating the original sale evidence.
model ConsignmentPayableEntry {
  id                 String                      @id @default(cuid())
  type               ConsignmentPayableEntryType
  supplierId         String
  itemId             String
  orderId            String
  orderItemId        String
  refundId           String?
  reversalOfId       String?                     @unique
  quantity           Int
  unitSalePriceCents Int
  grossSaleCents     Int
  commissionRateBps  Int
  commissionCents    Int
  payableCents       Int
  ruleSnapshot       Json
  occurredAt         DateTime
  idempotencyKey     String                      @unique
  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  item               InventoryItem               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  order              Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem          OrderItem                   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  refund             Refund?                     @relation(fields: [refundId], references: [id], onDelete: Restrict)
  reversalOf         ConsignmentPayableEntry?    @relation("ConsignmentPayableReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         ConsignmentPayableEntry?    @relation("ConsignmentPayableReversal")
  settlementLines    ConsignmentSettlementLine[]
  createdAt          DateTime                    @default(now())

  @@index([supplierId, occurredAt])
  @@index([orderId, createdAt])
  @@index([orderItemId, type])
  @@index([refundId])
  @@index([type, occurredAt])
}

/// Versioned supplier statement. Monetary totals are frozen from its lines;
/// returns and disputes move the workflow back to DRAFT, while VOID releases
/// the active line claims without deleting the historic statement snapshot.
model ConsignmentSettlement {
  id                     String                            @id @default(cuid())
  statementNo            String                            @unique
  supplierId             String
  periodStart            DateTime
  periodEnd              DateTime
  version                Int                               @default(1)
  status                 SettlementStatus                  @default(DRAFT)
  entryCount             Int
  netQuantity            Int
  grossSaleCents         Int
  commissionCents        Int
  payableCents           Int
  ruleSnapshot           Json
  creationReason         String
  creationIdempotencyKey String                            @unique
  creationCommandHash    String
  createdById            String
  submittedById          String?
  confirmedById          String?
  settledById            String?
  voidedById             String?
  submittedAt            DateTime?
  confirmedAt            DateTime?
  settledAt              DateTime?
  voidedAt               DateTime?
  paymentReference       String?
  supplier               Supplier                          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy              User                              @relation("ConsignmentSettlementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy            User?                             @relation("ConsignmentSettlementSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  confirmedBy            User?                             @relation("ConsignmentSettlementConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  settledBy              User?                             @relation("ConsignmentSettlementSettler", fields: [settledById], references: [id], onDelete: Restrict)
  voidedBy               User?                             @relation("ConsignmentSettlementVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  lines                  ConsignmentSettlementLine[]
  transitions            ConsignmentSettlementTransition[]
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt

  @@unique([supplierId, periodStart, periodEnd, version], map: "consignment_settlement_supplier_period_version_key")
  @@index([supplierId, status, periodEnd])
  @@index([status, periodEnd])
  @@index([createdById, createdAt])
}

model ConsignmentSettlementLine {
  id              String                  @id @default(cuid())
  settlementId    String
  payableEntryId  String
  quantity        Int
  grossSaleCents  Int
  commissionCents Int
  payableCents    Int
  releasedAt      DateTime?
  settlement      ConsignmentSettlement   @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payableEntry    ConsignmentPayableEntry @relation(fields: [payableEntryId], references: [id], onDelete: Restrict)
  createdAt       DateTime                @default(now())

  @@unique([settlementId, payableEntryId], map: "consignment_settlement_line_statement_entry_key")
  @@index([payableEntryId, releasedAt])
  @@index([settlementId, releasedAt])
}

model ConsignmentSettlementTransition {
  id             String                      @id @default(cuid())
  settlementId   String
  action         ConsignmentSettlementAction
  fromStatus     SettlementStatus?
  toStatus       SettlementStatus
  reason         String
  actorId        String
  idempotencyKey String                      @unique
  commandHash    String
  settlement     ConsignmentSettlement       @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  actor          User                        @relation("ConsignmentSettlementTransitionActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt      DateTime                    @default(now())

  @@index([settlementId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model InventoryLocation {
  id                 String                  @id @default(cuid())
  code               String                  @unique
  name               String
  enabled            Boolean                 @default(true)
  defaultItems       InventoryItem[]         @relation("InventoryItemDefaultLocation")
  stockBalances      InventoryStockBalance[]
  purchaseOrderLines PurchaseOrderLine[]
  receiptLines       PurchaseReceiptLine[]
  stocktakes         Stocktake[]
  sourceOperations   InventoryOperation[]    @relation("InventoryOperationSourceLocation")
  targetOperations   InventoryOperation[]    @relation("InventoryOperationTargetLocation")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model InventoryStockBalance {
  id         String            @id @default(cuid())
  itemId     String
  locationId String
  batchCode  String            @default("DEFAULT")
  expiresAt  DateTime?
  quantity   Int               @default(0)
  item       InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([itemId, locationId, batchCode])
  @@index([locationId, quantity])
  @@index([expiresAt])
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  orderNo       String              @unique
  supplierId    String
  status        PurchaseOrderStatus @default(DRAFT)
  remark        String?
  createdById   String
  submittedById String?
  approvedById  String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy   User?               @relation("PurchaseOrderSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy    User?               @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  lines         PurchaseOrderLine[]
  receipts      PurchaseReceipt[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([supplierId, status])
}

model PurchaseOrderLine {
  id               String                @id @default(cuid())
  purchaseOrderId  String
  itemId           String
  locationId       String
  orderedQuantity  Int
  receivedQuantity Int                   @default(0)
  unitCostCents    Int
  batchCode        String                @default("DEFAULT")
  expiresAt        DateTime?
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  item             InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location         InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  receiptLines     PurchaseReceiptLine[]
  createdAt        DateTime              @default(now())

  @@unique([purchaseOrderId, itemId, locationId, batchCode], map: "po_line_item_location_batch_key")
  @@index([itemId])
}

model PurchaseReceipt {
  id              String                @id @default(cuid())
  receiptNo       String                @unique
  purchaseOrderId String
  operatorId      String
  idempotencyKey  String                @unique
  receivedAt      DateTime              @default(now())
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  operator        User                  @relation("PurchaseReceiptOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  lines           PurchaseReceiptLine[]
  createdAt       DateTime              @default(now())

  @@index([purchaseOrderId, receivedAt])
}

model PurchaseReceiptLine {
  id                     String               @id @default(cuid())
  receiptId              String
  purchaseOrderLineId    String
  locationId             String
  quantity               Int
  batchCode              String
  expiresAt              DateTime?
  inventoryTransactionId String               @unique
  receipt                PurchaseReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseOrderLine      PurchaseOrderLine    @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  location               InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  inventoryTransaction   InventoryTransaction @relation(fields: [inventoryTransactionId], references: [id], onDelete: Restrict)

  @@unique([receiptId, purchaseOrderLineId])
}

model Stocktake {
  id                 String            @id @default(cuid())
  stocktakeNo        String            @unique
  locationId         String
  status             StocktakeStatus   @default(DRAFT)
  reason             String
  createdById        String
  submittedById      String?
  reviewedById       String?
  postedById         String?
  startedAt          DateTime?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  postedAt           DateTime?
  postIdempotencyKey String?           @unique
  location           InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy          User              @relation("StocktakeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy        User?             @relation("StocktakeSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy         User?             @relation("StocktakeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  postedBy           User?             @relation("StocktakePoster", fields: [postedById], references: [id], onDelete: Restrict)
  lines              StocktakeLine[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([locationId, status])
}

model StocktakeLine {
  id                     String                @id @default(cuid())
  stocktakeId            String
  itemId                 String
  batchCode              String
  expiresAt              DateTime?
  bookQuantity           Int
  countedQuantity        Int?
  difference             Int?
  inventoryTransactionId String?               @unique
  stocktake              Stocktake             @relation(fields: [stocktakeId], references: [id], onDelete: Restrict)
  item                   InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  inventoryTransaction   InventoryTransaction? @relation(fields: [inventoryTransactionId], references: [id], onDelete: Restrict)

  @@unique([stocktakeId, itemId, batchCode])
}

model InventoryOperation {
  id                  String                   @id @default(cuid())
  documentNo          String                   @unique
  type                InventoryOperationType
  status              InventoryOperationStatus @default(DRAFT)
  itemId              String
  quantity            Int
  batchCode           String                   @default("DEFAULT")
  expiresAt           DateTime?
  sourceLocationId    String
  targetLocationId    String?
  reason              String
  referenceType       String?
  referenceId         String?
  createdById         String
  approvedById        String?
  postedById          String?
  submittedAt         DateTime?
  approvedAt          DateTime?
  postedAt            DateTime?
  cancelledAt         DateTime?
  postIdempotencyKey  String?                  @unique
  sourceTransactionId String?                  @unique
  targetTransactionId String?                  @unique
  item                InventoryItem            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sourceLocation      InventoryLocation        @relation("InventoryOperationSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  targetLocation      InventoryLocation?       @relation("InventoryOperationTargetLocation", fields: [targetLocationId], references: [id], onDelete: Restrict)
  createdBy           User                     @relation("InventoryOperationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy          User?                    @relation("InventoryOperationApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  postedBy            User?                    @relation("InventoryOperationPoster", fields: [postedById], references: [id], onDelete: Restrict)
  sourceTransaction   InventoryTransaction?    @relation("InventoryOperationSourceTransaction", fields: [sourceTransactionId], references: [id], onDelete: Restrict)
  targetTransaction   InventoryTransaction?    @relation("InventoryOperationTargetTransaction", fields: [targetTransactionId], references: [id], onDelete: Restrict)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([sourceLocationId, status])
  @@index([targetLocationId, status])
}

model ExportJob {
  id          String       @id @default(cuid())
  userId      String
  scope       String
  filters     Json
  format      String       @default("xlsx")
  status      ExportStatus @default(PENDING)
  fileKey     String?
  downloadUrl String?
  expiresAt   DateTime?
  error       String?
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DataErasureRequest {
  id                     String                   @id @default(cuid())
  userId                 String
  status                 DataErasureRequestStatus @default(REQUESTED)
  reason                 String
  requestIdempotencyKey  String                   @unique
  requestCommandHash     String
  decisionIdempotencyKey String?                  @unique
  decisionCommandHash    String?
  reviewedById           String?
  reviewReason           String?
  requestedAt            DateTime                 @default(now())
  reviewedAt             DateTime?
  completedAt            DateTime?
  user                   User                     @relation("DataErasureRequester", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy             User?                    @relation("DataErasureReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
  @@index([reviewedById, reviewedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  content   String
  payload   Json?
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}
