  @@index([enrollmentId, status])
}

model TrainingSettlement {
  id                          String                       @id @default(cuid())
  periodStart                 DateTime
  periodEnd                   DateTime
  effectiveRevenueCents       Int
  contractRateBps             Int                          @default(2000)
  venueContributionCents      Int
  venueFeeCents               Int                          @default(0)
  trainingPayableVenueCents   Int                          @default(0)
  coachCostCents              Int                          @default(0)
  assistantCostCents          Int                          @default(0)
  materialCostCents           Int                          @default(0)
  acquisitionCostCents        Int                          @default(0)
  marketingCostCents          Int                          @default(0)
  occupiedCourtHours          Decimal                      @default(0) @db.Decimal(10, 2)
  cashContributionMarginCents Int
  status                      SettlementStatus             @default(DRAFT)
