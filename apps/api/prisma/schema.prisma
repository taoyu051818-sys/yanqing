  class                 TrainingClass?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  student               Student?                     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  buyer                 User                         @relation("TrainingPurchases", fields: [buyerId], references: [id], onDelete: Restrict)
  order                 Order?                       @relation(fields: [orderId], references: [id], onDelete: SetNull)
