  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([memberId, status, endsAt])
}

model Order {
  id                     String                    @id @default(cuid())
  orderNo                String                    @unique
  creationIdempotencyKey String?                   @unique
  creationCommandHash    String?
  memberId               String
  createdById            String?
  businessType           BusinessType
  subjectAccount         SubjectAccount
  paymentChannel         PaymentChannel?
  sourceChannel          SourceChannel
  status                 OrderStatus               @default(PENDING)
  title                  String
  listAmountCents        Int
  discountCents          Int                       @default(0)
  payableCents           Int
  paidCents              Int                       @default(0)
  refundedCents          Int                       @default(0)
  externalOrderNo        String?                   @unique
  consumedCouponCode     String?
  parameterSnapshot      Json
  paidAt                 DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  member                 User                      @relation("MemberOrders", fields: [memberId], references: [id], onDelete: Restrict)
  createdBy              User?                     @relation("CreatedOrders", fields: [createdById], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  payments               Payment[]
  refunds                Refund[]
  accountTransactions    AccountTransaction[]
  riskEvents             RiskEvent[]
  bookings               CourtBooking[]
  membership             MemberSubscription?
  gameRegistration       GameRegistration?
  eventTeam              EventTeam?
  trainingEnrollment     TrainingEnrollment?
  couponAttributions     CouponCode[]              @relation("CouponAttributionOrder")
  referralRewards        ReferralReward[]
  consignmentPayables    ConsignmentPayableEntry[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([memberId, createdAt])
  @@index([businessType, subjectAccount, createdAt])
  @@index([status, createdAt])
  @@index([sourceChannel, createdAt])
}

model OrderItem {
  id                    String                    @id @default(cuid())
  orderId               String
  itemType              String
  itemId                String?
  name                  String
