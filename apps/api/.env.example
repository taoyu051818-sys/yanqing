NODE_ENV=development
# Explicit opt-in for an isolated local/test database only. Keep false on public servers.
DEV_LOGIN_ENABLED=false
# Exact HTTPS origin of the PC admin console; blank leaves browser login disabled.
ADMIN_CONSOLE_ORIGIN=
PORT=3200
HOST=0.0.0.0
API_PREFIX=api/v1
DATABASE_URL=postgresql://yanqing:yanqing_dev_password@localhost:5432/yanqing?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# WeChat Mini Program. Development login works without these values.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
# Prefer file paths in deployed environments; do not commit private keys.
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
# Recommended public-key verification mode.
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_PUBLIC_KEY_PATH=
# Legacy platform-certificate verification mode (fallback).
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
PAYMENT_PROVIDER=mock

# Object storage / messaging adapters
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# Optional override for user-uploaded public assets. Defaults to STORAGE_LOCAL_PATH.
UPLOAD_DIR=
SMS_PROVIDER=mock

# Owner briefing: server-only. Never place this key in VITE_* or client builds.
BOSS_MONITOR_ENABLED=true
BOSS_LLM_BASE_URL=https://vip.aipro.love/v1
BOSS_LLM_MODEL=gpt-5.6-sol
BOSS_LLM_API_KEY=
BOSS_LARGE_ORDER_CENTS=100000
BOSS_LARGE_RECHARGE_CENTS=200000
BOSS_FREQUENT_REFUND_COUNT=3
BOSS_PAYMENT_STUCK_MINUTES=10
BOSS_OVERDUE_ORDER_MINUTES=30
BOSS_LOW_UTILIZATION_PERCENT=20
BOSS_NEAR_FULL_PERCENT=90
BOSS_LOW_SIGNUP_PERCENT=30
BOSS_SIGNUP_LEAD_HOURS=24
