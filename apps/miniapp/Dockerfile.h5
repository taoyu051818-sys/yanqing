FROM node:24-alpine AS builder
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/miniapp/package.json apps/miniapp/package.json
RUN pnpm install --frozen-lockfile --filter @yanqing/miniapp...

COPY apps/miniapp apps/miniapp

ARG VITE_API_BASE_URL
ARG VITE_DATA_MODE=remote
ARG VITE_ENABLE_REMOTE_DEV_LOGIN=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_DATA_MODE=$VITE_DATA_MODE
ENV VITE_ENABLE_REMOTE_DEV_LOGIN=$VITE_ENABLE_REMOTE_DEV_LOGIN

RUN pnpm --dir apps/miniapp build:h5

FROM nginx:1.27-alpine
COPY deploy/h5-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/miniapp/dist/build/h5 /usr/share/nginx/html
EXPOSE 80
